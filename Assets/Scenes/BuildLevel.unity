  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'The Tayagan is a large species of bear, with a long tail for better balance
    and coordination. Its coloring is predominantly blue. It has a long nose, which
    gives it a more sensitive sense of smell, making it very useful for various expeditions
    and hunting.



    Our friend has lost his sense of smell; it seems his nose
    is blocked. To fix this, you''ll need to:

    1. Fill with water and set the
    temperature to very hot.

    2. Generate magma on the synthesis table, then
    combine it with some black pepper and sage in a cauldron.

    3. Before crafting...
    make sure the state of matter is gas!'
